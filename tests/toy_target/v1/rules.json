{
  "schema_version": "0.5",
  "file_version": "2",
  "target_name": "Toy",
  "target_version_pattern": "^1\\.",
  "tables": [
    {
      "output": ".h5mu",
      "base": {
        "measurements": {
          "primary_layer": "X",
          "layers": [{"name": "X", "source": {"measurements": "primary_layer"}}]
        }
      },
      "uns": [
        {"name": "toy_version", "how": "constant", "value": "1"},
        {"name": "toy_modalities", "how": "constant", "value": ["protein", "peptidoform_ion"]},
        {"name": "search_engine", "source": {"rule": "software_name"}}
      ],
      "feature_links": [
        {"name": "feature_mapping", "column": "protein_group", "target": "protein"}
      ],
      "levels": {
        "protein": {
          "modality": "protein",
          "required": false,
          "axis": {"obs_key": "assay_id", "var_key": "protein_group"},
          "columns": {
            "obs": [
              {
                "name": "assay_id",
                "source": {"obs": "assay_name"},
                "fallback": [{"axis": "obs_key"}]
              },
              {"name": "raw_file", "source": {"axis": "obs_key"}},
              {"name": "sample_id", "source": {"obs": "source_name"}, "required": false},
              {
                "name": "condition",
                "source": {"obs": "factor_value_spiked_compound"},
                "required": false
              },
              {
                "name": "organism",
                "source": {"obs": "characteristics_organism"},
                "required": false
              },
              {"name": "label", "source": {"obs": "comment_label"}, "required": false}
            ],
            "var": [
              {"name": "protein_group", "source": {"catalog": "apb", "var": "protein_assignment"}}
            ]
          }
        },
        "peptidoform": {
          "modality": "peptidoform",
          "required": false,
          "axis": {"obs_key": "assay_id", "var_key": "peptidoform"},
          "columns": {
            "obs": [
              {
                "name": "assay_id",
                "source": {"obs": "assay_name"},
                "fallback": [{"axis": "obs_key"}]
              },
              {"name": "raw_file", "source": {"axis": "obs_key"}},
              {"name": "sample_id", "source": {"obs": "source_name"}, "required": false},
              {
                "name": "condition",
                "source": {"obs": "factor_value_spiked_compound"},
                "required": false
              },
              {
                "name": "organism",
                "source": {"obs": "characteristics_organism"},
                "required": false
              },
              {"name": "label", "source": {"obs": "comment_label"}, "required": false}
            ],
            "var": [{"name": "peptidoform", "source": {"catalog": "apb", "var": "peptidoform"}}]
          }
        },
        "peptidoform_ion": {
          "modality": "peptidoform_ion",
          "required": false,
          "axis": {"obs_key": "assay_id", "var_key": "precursor"},
          "measurements": {
            "layers": [
              {
                "name": "q_value",
                "source": {"catalog": "confidence", "layers": "q_value"},
                "required": true
              },
              {
                "name": "ms1_q_value",
                "source": {"catalog": "confidence", "layers": "quantification_q_value"},
                "required": false
              }
            ]
          },
          "columns": {
            "obs": [
              {
                "name": "assay_id",
                "source": {"obs": "assay_name"},
                "fallback": [{"axis": "obs_key"}]
              },
              {"name": "raw_file", "source": {"axis": "obs_key"}},
              {"name": "sample_id", "source": {"obs": "source_name"}, "required": false},
              {
                "name": "condition",
                "source": {"obs": "factor_value_spiked_compound"},
                "required": false
              },
              {
                "name": "organism",
                "source": {"obs": "characteristics_organism"},
                "required": false
              },
              {"name": "label", "source": {"obs": "comment_label"}, "required": false}
            ],
            "var": [
              {"name": "precursor", "source": {"catalog": "apb", "var": "peptidoform_ion"}},
              {
                "name": "protein_group",
                "source": {"catalog": "apb", "var": "protein_assignment"},
                "required": false
              },
              {
                "name": "group_specific",
                "source": {"fasta": "is_protein_group_specific"},
                "type": "boolean",
                "required": false
              }
            ]
          },
          "uns": [{"name": "level", "how": "constant", "value": "peptidoform_ion"}]
        }
      }
    }
  ]
}
