{
  "schema_version": "0.5",
  "file_version": "3",
  "target_name": "prolfquapp",
  "target_version_pattern": "^2\\.11\\.",
  "tables": [
    {
      "output": ".h5ad",
      "base": {
        "axis": {"obs_key": "sampleName", "var_key": "feature_id"},
        "measurements": {
          "primary_layer": "intensity",
          "layers": [
            {
              "name": "intensity",
              "source": {"catalog": "abundance", "layers": "intensity"},
              "fallback": [{"measurements": "primary_layer"}]
            },
            {
              "name": "qValue",
              "source": {"catalog": "confidence", "layers": "q_value"},
              "fallback": [{"catalog": "proteobench_entrapment", "var": "q_value"}],
              "required": false
            },
            {
              "name": "pg_qValue",
              "source": {"catalog": "confidence", "layers": "q_value", "from_level": "protein"},
              "required": false
            },
            {
              "name": "pg_qValue_experiment",
              "source": {
                "catalog": "confidence",
                "var": "library_q_value",
                "from_level": "protein",
                "accept": "nonzero"
              },
              "fallback": [{"catalog": "confidence", "var": "q_value", "from_level": "protein"}],
              "required": false
            },
            {
              "name": "pep",
              "source": {"catalog": "confidence", "layers": "pep"},
              "fallback": [{"catalog": "confidence", "var": "pep"}],
              "required": false
            }
          ]
        },
        "columns": {
          "obs": [
            {"name": "sampleName", "source": {"axis": "obs_key"}},
            {"name": "raw.file", "source": {"axis": "obs_key"}},
            {"name": "annotations", "how": "all_values"}
          ],
          "var": [
            {
              "name": "feature_id",
              "how": "join_nonempty",
              "inputs": [
                {"catalog": "apb", "var": "protein_assignment"},
                {"catalog": "apb", "var": "peptide"}
              ],
              "separator": "~"
            },
            {
              "name": "protein_Id",
              "source": {"catalog": "apb", "var": "protein_assignment"},
              "drop_missing": true
            },
            {
              "name": "IDcolumn",
              "source": {"fasta": "reported_leading_accession"},
              "fallback": [{"catalog": "apb", "var": "protein_assignment"}]
            },
            {
              "name": "fasta.id",
              "source": {"fasta": "reported_leading_id"},
              "fallback": [{"catalog": "apb", "var": "protein_assignment"}]
            },
            {
              "name": "description",
              "source": {"fasta": "reported_leading_description"},
              "fallback": [{"catalog": "apb", "var": "protein_assignment"}]
            },
            {
              "name": "gene_name",
              "source": {"fasta": "reported_leading_gene_name"},
              "required": false
            },
            {
              "name": "protein_length",
              "source": {"fasta": "reported_leading_protein_length"},
              "type": "number",
              "required": false
            },
            {
              "name": "nr_tryptic_peptides",
              "source": {"fasta": "reported_leading_tryptic_peptides"},
              "type": "number",
              "required": false
            },
            {"name": "peptide_Id", "source": {"catalog": "apb", "var": "peptide"}},
            {"name": "nr_children", "how": "constant", "value": 1, "type": "integer"}
          ]
        },
        "uns": [
          {"name": "X_layer_name", "how": "constant", "value": "intensity"},
          {"name": "prolfquapp.artifact_type", "how": "constant", "value": "lfqdata"},
          {"name": "prolfquapp.schema_version", "how": "constant", "value": "1.0.0"},
          {
            "name": "prolfquapp.source_software",
            "source": {"rule": "software_name"},
            "required": false,
            "fill_value": "unknown"
          },
          {
            "name": "prolfquapp.protein_annotation",
            "how": "constant",
            "value": {
              "pID": "protein_Id",
              "full_id": "protein_Id",
              "description": "description",
              "cleaned_ids": "IDcolumn",
              "exp_nr_children": "nrPeptides",
              "pattern_contaminants": "^zz|^CON|Cont_",
              "pattern_decoys": "^REV_|^rev"
            }
          },
          {
            "name": "prolfquapp.layer_names",
            "how": "constant",
            "value": ["intensity", "qValue", "pg_qValue", "pg_qValue_experiment", "pep"]
          }
        ]
      },
      "levels": {
        "peptide": {
          "software": ["MaxQuant"],
          "uns": [
            {
              "name": "prolfquapp.analysis_configuration",
              "how": "constant",
              "value": {
                "sep": "~",
                "file_name": "raw.file",
                "sample_name": "sampleName",
                "isotope_label": "isotopeLabel",
                "ident_q_value": "qValue",
                "nr_children": "nr_children",
                "work_intensity": ["intensity"],
                "is_response_transformed": false,
                "factor_depth": 1,
                "hierarchy": {"protein_Id": ["protein_Id"], "peptide_Id": ["peptide_Id"]},
                "hierarchy_keys": ["protein_Id", "peptide_Id"],
                "hierarchy_depth": 1,
                "min_peptides_protein": 2
              }
            },
            {"name": "prolfquapp.analysis_configuration.factors", "how": "annotation_map"}
          ]
        },
        "peptidoform_ion": {
          "columns": {
            "var": [
              {
                "name": "feature_id",
                "how": "join_nonempty",
                "inputs": [
                  {"catalog": "apb", "var": "protein_assignment"},
                  {"catalog": "apb", "var": "peptide"},
                  {"catalog": "apb", "var": "peptidoform_ion"}
                ],
                "separator": "~"
              },
              {"name": "precursor_Id", "source": {"catalog": "apb", "var": "peptidoform_ion"}}
            ]
          },
          "uns": [
            {
              "name": "prolfquapp.analysis_configuration",
              "how": "constant",
              "value": {
                "sep": "~",
                "file_name": "raw.file",
                "sample_name": "sampleName",
                "isotope_label": "isotopeLabel",
                "ident_q_value": "qValue",
                "nr_children": "nr_children",
                "work_intensity": ["intensity"],
                "is_response_transformed": false,
                "factor_depth": 1,
                "hierarchy": {
                  "protein_Id": ["protein_Id"],
                  "peptide_Id": ["peptide_Id"],
                  "precursor_Id": ["precursor_Id"]
                },
                "hierarchy_keys": ["protein_Id", "peptide_Id", "precursor_Id"],
                "hierarchy_depth": 1,
                "min_peptides_protein": 2
              }
            },
            {"name": "prolfquapp.analysis_configuration.factors", "how": "annotation_map"}
          ]
        }
      }
    }
  ]
}
