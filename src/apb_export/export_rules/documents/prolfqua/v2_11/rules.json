{
  "schema_version": "0.4",
  "file_version": "2",
  "target_name": "prolfquapp",
  "target_version_pattern": "^2\\.11\\.",
  "tables": [
    {
      "output": {"extensions": [".h5ad"]},
      "base": {
        "axis": {"obs_keys": ["sampleName"], "var_keys": ["feature_id"]},
        "measurements": {
          "primary_layer": "intensity",
          "layers": [
            {"name": "intensity", "source": [
              {"catalog": "abundance", "kind": "intensity", "enforce": "MUST"},
              {"measurements": "primary_layer"}
            ]},
            {
              "name": "qValue",
              "source": [
                {
                  "catalog": "confidence",
                  "kind": "q_value"
                },
                {
                  "catalog": "proteobench_entrapment",
                  "kind": "global_q_value",
                  "location": "var"
                }
              ]
            },
            {
              "name": "pg_qValue",
              "source": {
                "catalog": "confidence",
                "kind": "q_value",
                "level": "protein"
              }
            },
            {
              "name": "pg_qValue_experiment",
              "source": [
                {
                  "catalog": "confidence",
                  "kind": "library_q_value",
                  "location": "var",
                  "level": "protein",
                  "accept": "nonzero"
                },
                {
                  "catalog": "confidence",
                  "kind": "global_q_value",
                  "location": "var",
                  "level": "protein"
                }
              ]
            },
            {
              "name": "pep",
              "source": [
                {"catalog": "confidence", "kind": "pep"},
                {
                  "catalog": "confidence",
                  "kind": "pep",
                  "location": "var"
                }
              ]
            }
          ]
        }
      },
      "levels": {
        "peptide": {
          "software": ["MaxQuant"],
          "columns": {
            "obs": [
              {"name": "sampleName", "source": {"axis": "obs_keys"}},
              {"name": "raw.file", "source": {"axis": "obs_keys"}},
              {"name": "annotations", "how": "all_values"}
            ],
            "var": [
              {
                "name": "feature_id",
                "how": "join_nonempty",
                "inputs": [{"catalog": "apb", "kind": "protein_assignment", "location": "var"}, {"catalog": "apb", "kind": "peptide", "location": "var"}],
                "separator": "~"
              },
              {"name": "protein_Id", "source": {"catalog": "apb", "kind": "protein_assignment", "location": "var"}, "drop_missing": true},
              {
                "name": "IDcolumn",
                "source": [{"fasta": "reported_leading_accession"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {
                "name": "fasta.id",
                "source": [{"fasta": "reported_leading_id"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {
                "name": "description",
                "source": [{"fasta": "reported_leading_description"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {"name": "gene_name", "source": {"fasta": "reported_leading_gene_name"}, "required": false},
              {
                "name": "protein_length",
                "source": {"fasta": "reported_leading_protein_length"},
                "type": "number",
                "required": false
              },
              {
                "name": "nr_tryptic_peptides",
                "source": {"fasta": "reported_leading_tryptic_peptides"},
                "type": "number",
                "required": false
              },
              {"name": "peptide_Id", "source": {"catalog": "apb", "kind": "peptide", "location": "var"}},
              {"name": "nr_children", "how": "constant", "value": 1, "type": "integer"}
            ]
          },
          "uns": [
            {"name": "X_layer_name", "how": "constant", "value": "intensity"},
            {"name": "prolfquapp.artifact_type", "how": "constant", "value": "lfqdata"},
            {"name": "prolfquapp.schema_version", "how": "constant", "value": "1.0.0"},
            {
              "name": "prolfquapp.source_software",
              "source": {"rule": "software_name"},
              "required": false,
              "fill_value": "unknown"
            },
            {
              "name": "prolfquapp.analysis_configuration",
              "how": "constant",
              "value": {
                "sep": "~",
                "file_name": "raw.file",
                "sample_name": "sampleName",
                "isotope_label": "isotopeLabel",
                "ident_q_value": "qValue",
                "nr_children": "nr_children",
                "work_intensity": ["intensity"],
                "is_response_transformed": false,
                "factor_depth": 1,
                "hierarchy": {"protein_Id": ["protein_Id"], "peptide_Id": ["peptide_Id"]},
                "hierarchy_keys": ["protein_Id", "peptide_Id"],
                "hierarchy_depth": 1,
                "min_peptides_protein": 2
              }
            },
            {"name": "prolfquapp.analysis_configuration.factors", "how": "annotation_map"},
            {
              "name": "prolfquapp.protein_annotation",
              "how": "constant",
              "value": {
                "pID": "protein_Id",
                "full_id": "protein_Id",
                "description": "description",
                "cleaned_ids": "IDcolumn",
                "exp_nr_children": "nrPeptides",
                "pattern_contaminants": "^zz|^CON|Cont_",
                "pattern_decoys": "^REV_|^rev"
              }
            },
            {
              "name": "prolfquapp.layer_names",
              "how": "constant",
              "value": ["intensity", "qValue", "pg_qValue", "pg_qValue_experiment", "pep"]
            }
          ]
        },
        "peptidoform_ion": {
          "columns": {
            "obs": [
              {"name": "sampleName", "source": {"axis": "obs_keys"}},
              {"name": "raw.file", "source": {"axis": "obs_keys"}},
              {"name": "annotations", "how": "all_values"}
            ],
            "var": [
              {
                "name": "feature_id",
                "how": "join_nonempty",
                "inputs": [{"catalog": "apb", "kind": "protein_assignment", "location": "var"}, {"catalog": "apb", "kind": "peptide", "location": "var"}, {"catalog": "apb", "kind": "peptidoform_ion", "location": "var"}],
                "separator": "~"
              },
              {"name": "protein_Id", "source": {"catalog": "apb", "kind": "protein_assignment", "location": "var"}, "drop_missing": true},
              {
                "name": "IDcolumn",
                "source": [{"fasta": "reported_leading_accession"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {
                "name": "fasta.id",
                "source": [{"fasta": "reported_leading_id"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {
                "name": "description",
                "source": [{"fasta": "reported_leading_description"}, {"catalog": "apb", "kind": "protein_assignment", "location": "var"}]
              },
              {"name": "gene_name", "source": {"fasta": "reported_leading_gene_name"}, "required": false},
              {
                "name": "protein_length",
                "source": {"fasta": "reported_leading_protein_length"},
                "type": "number",
                "required": false
              },
              {
                "name": "nr_tryptic_peptides",
                "source": {"fasta": "reported_leading_tryptic_peptides"},
                "type": "number",
                "required": false
              },
              {"name": "peptide_Id", "source": {"catalog": "apb", "kind": "peptide", "location": "var"}},
              {"name": "precursor_Id", "source": {"catalog": "apb", "kind": "peptidoform_ion", "location": "var"}},
              {"name": "nr_children", "how": "constant", "value": 1, "type": "integer"}
            ]
          },
          "uns": [
            {"name": "X_layer_name", "how": "constant", "value": "intensity"},
            {"name": "prolfquapp.artifact_type", "how": "constant", "value": "lfqdata"},
            {"name": "prolfquapp.schema_version", "how": "constant", "value": "1.0.0"},
            {
              "name": "prolfquapp.source_software",
              "source": {"rule": "software_name"},
              "required": false,
              "fill_value": "unknown"
            },
            {
              "name": "prolfquapp.analysis_configuration",
              "how": "constant",
              "value": {
                "sep": "~",
                "file_name": "raw.file",
                "sample_name": "sampleName",
                "isotope_label": "isotopeLabel",
                "ident_q_value": "qValue",
                "nr_children": "nr_children",
                "work_intensity": ["intensity"],
                "is_response_transformed": false,
                "factor_depth": 1,
                "hierarchy": {
                  "protein_Id": ["protein_Id"],
                  "peptide_Id": ["peptide_Id"],
                  "precursor_Id": ["precursor_Id"]
                },
                "hierarchy_keys": ["protein_Id", "peptide_Id", "precursor_Id"],
                "hierarchy_depth": 1,
                "min_peptides_protein": 2
              }
            },
            {"name": "prolfquapp.analysis_configuration.factors", "how": "annotation_map"},
            {
              "name": "prolfquapp.protein_annotation",
              "how": "constant",
              "value": {
                "pID": "protein_Id",
                "full_id": "protein_Id",
                "description": "description",
                "cleaned_ids": "IDcolumn",
                "exp_nr_children": "nrPeptides",
                "pattern_contaminants": "^zz|^CON|Cont_",
                "pattern_decoys": "^REV_|^rev"
              }
            },
            {
              "name": "prolfquapp.layer_names",
              "how": "constant",
              "value": ["intensity", "qValue", "pg_qValue", "pg_qValue_experiment", "pep"]
            }
          ]
        }
      }
    }
  ]
}
