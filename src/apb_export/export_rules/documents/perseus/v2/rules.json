{
  "schema_version": "0.5",
  "file_version": "2",
  "target_name": "Perseus",
  "target_version_pattern": "^2\\.",
  "tables": [
    {
      "output": ".txt",
      "levels": {
        "protein": {
          "axis": {"obs_key": "Sample", "var_key": "Protein IDs"},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": {"measurements": "primary_layer"},
                "missing_values": [0],
                "name_by_key": {"aggregation=maxlfq": "LFQ intensity", "ibaq": "iBAQ"}
              }
            ]
          },
          "columns": {
            "obs": [
              {"name": "Sample", "source": {"axis": "obs_key"}},
              {"name": "annotations", "how": "all_values"}
            ],
            "var": [
              {
                "name": "Protein IDs",
                "source": {"catalog": "apb_alpha", "var": "protein_assignment"}
              },
              {"name": "Gene names", "source": {"fasta": "fasta_gene_names"}, "required": false},
              {
                "name": "Q-value",
                "source": {"catalog": "confidence_alpha", "var": "q_value"},
                "fallback": [
                  {"catalog": "confidence_alpha", "var": "library_q_value", "accept": "nonzero"}
                ],
                "type": "number",
                "required": false
              },
              {
                "name": "Reverse",
                "source": {"catalog": "apb_alpha", "var": "decoy"},
                "type": "boolean"
              },
              {"name": "Potential contaminant", "how": "contaminant", "type": "boolean"}
            ]
          }
        }
      }
    }
  ]
}
