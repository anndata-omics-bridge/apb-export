{
  "schema_version": "0.5",
  "file_version": "2",
  "target_name": "MSstats",
  "target_version_pattern": "^4\\.20\\.",
  "tables": [
    {
      "output": ".csv",
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_key": "Run", "var_key": "PrecursorId"},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": {"catalog": "abundance", "layers": "intensity"},
                "fallback": [{"measurements": "primary_layer"}],
                "missing_values": [0]
              },
              {
                "name": "DetectionQValue",
                "source": {"catalog": "confidence", "layers": "q_value"},
                "required": false
              },
              {
                "name": "PEP",
                "source": {"catalog": "confidence", "layers": "pep"},
                "fallback": [{"catalog": "confidence", "var": "pep"}],
                "required": false
              }
            ]
          },
          "columns": {
            "obs": [
              {"name": "Run", "source": {"axis": "obs_key"}},
              {"name": "Condition", "source": {"catalog": "apb", "obs": "group"}},
              {"name": "BioReplicate", "source": {"catalog": "apb", "obs": "subject"}}
            ],
            "var": [
              {"name": "PrecursorId", "source": {"catalog": "apb", "var": "peptidoform_ion"}},
              {
                "name": "ProteinName",
                "source": {"catalog": "apb", "var": "protein_assignment"},
                "drop_missing": true
              },
              {"name": "PeptideSequence", "source": {"catalog": "apb", "var": "peptidoform"}},
              {
                "name": "PrecursorCharge",
                "how": "proforma_charge",
                "source": {"catalog": "apb", "var": "peptidoform_ion"},
                "type": "integer"
              },
              {"name": "FragmentIon", "how": "constant", "value": null},
              {"name": "ProductCharge", "how": "constant", "value": null, "type": "integer"},
              {"name": "IsotopeLabelType", "how": "constant", "value": "L"}
            ]
          }
        }
      }
    }
  ]
}
