{
  "schema_version": "0.5",
  "file_version": "2",
  "target_name": "exploreDE",
  "target_version_pattern": "^3\\.(8|9)\\.",
  "tables": [
    {
      "output": ".h5ads",
      "base": {
        "axis": {"obs_key": "sample_id", "var_key": "feature_id"},
        "measurements": {
          "primary_layer": "X",
          "layers": [
            {
              "name": "X",
              "source": {"measurements": "primary_layer"},
              "missing_values": [0],
              "transform": "log2"
            },
            {
              "name": "intensities",
              "source": {"measurements": "primary_layer"},
              "missing_values": [0],
              "transform": "log2",
              "required": false
            },
            {
              "name": "intensities_raw",
              "source": {"measurements": "primary_layer"},
              "missing_values": [0],
              "required": false
            }
          ]
        },
        "columns": {
          "obs": [
            {"name": "sample_id", "source": {"axis": "obs_key"}},
            {"name": "sample_label", "source": {"axis": "obs_key"}},
            {
              "name": "annotations",
              "how": "all_values",
              "rename": [
                {"pattern": "^factor_value_(.+)$", "replacement": "factor_\\1", "identifier": true},
                {
                  "pattern": "(?i)^((?:group|bait).*)$",
                  "replacement": "factor_\\1",
                  "identifier": true
                }
              ]
            }
          ]
        },
        "required": false
      },
      "levels": {
        "protein": {
          "modality": "protein",
          "columns": {
            "var": [
              {"name": "feature_id", "source": {"catalog": "apb", "var": "protein_assignment"}},
              {
                "name": "label_protein_id",
                "source": {"catalog": "apb", "var": "protein_assignment"}
              },
              {
                "name": "label_gene_symbol",
                "how": "short_name",
                "inputs": [
                  {"fasta": "fasta_gene_names"},
                  {"catalog": "apb", "var": "protein_assignment"}
                ]
              },
              {"name": "description", "source": {"fasta": "fasta_descriptions"}, "required": false}
            ]
          },
          "uns": [
            {"name": "feature_id_kind", "how": "constant", "value": "protein"},
            {
              "name": "hierarchy",
              "how": "constant",
              "value": {"levels": ["protein"], "unit": "protein"}
            }
          ]
        },
        "peptide": {
          "modality": "peptide",
          "columns": {
            "var": [
              {
                "name": "feature_id",
                "how": "join_nonempty",
                "inputs": [
                  {"catalog": "apb", "var": "protein_assignment"},
                  {"catalog": "apb", "var": "peptide"}
                ],
                "separator": "_"
              },
              {
                "name": "label_protein_id",
                "source": {"catalog": "apb", "var": "protein_assignment"},
                "drop_missing": true
              },
              {
                "name": "label_gene_symbol",
                "how": "short_name",
                "inputs": [
                  {"fasta": "reported_leading_gene_name"},
                  {"fasta": "reported_leading_id"},
                  {"catalog": "apb", "var": "protein_assignment"}
                ],
                "append": {"catalog": "apb", "var": "peptide"}
              },
              {
                "name": "description",
                "source": {"fasta": "reported_leading_description"},
                "required": false
              }
            ]
          },
          "uns": [
            {"name": "feature_id_kind", "how": "constant", "value": "peptide"},
            {
              "name": "hierarchy",
              "how": "constant",
              "value": {"levels": ["protein", "peptide"], "unit": "peptide"}
            }
          ]
        },
        "peptidoform_ion": {
          "modality": "precursor",
          "columns": {
            "var": [
              {
                "name": "feature_id",
                "how": "join_nonempty",
                "inputs": [
                  {"catalog": "apb", "var": "protein_assignment"},
                  {"catalog": "apb", "var": "peptidoform_ion"}
                ],
                "separator": "_"
              },
              {
                "name": "label_protein_id",
                "source": {"catalog": "apb", "var": "protein_assignment"},
                "drop_missing": true
              },
              {
                "name": "label_gene_symbol",
                "how": "short_name",
                "inputs": [
                  {"fasta": "reported_leading_gene_name"},
                  {"fasta": "reported_leading_id"},
                  {"catalog": "apb", "var": "protein_assignment"}
                ],
                "append": {"catalog": "apb", "var": "peptidoform_ion"}
              },
              {
                "name": "description",
                "source": {"fasta": "reported_leading_description"},
                "required": false
              }
            ]
          },
          "uns": [
            {"name": "feature_id_kind", "how": "constant", "value": "precursor"},
            {
              "name": "hierarchy",
              "how": "constant",
              "value": {"levels": ["protein", "peptide", "precursor"], "unit": "precursor"}
            }
          ]
        }
      },
      "uns": [
        {"name": "schema_version", "how": "constant", "value": "exploreDE/1.0"},
        {"name": "omics_type", "how": "constant", "value": "proteomics"},
        {"name": "de", "how": "constant", "value": {}},
        {"name": "enrichment", "how": "constant", "value": {}},
        {"name": "enrichment_support", "how": "constant", "value": {}},
        {"name": "provenance", "how": "constant", "value": {"source_format": "apb-export"}}
      ]
    }
  ]
}
