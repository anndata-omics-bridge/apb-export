{
  "schema_version": "0.5",
  "file_version": "4",
  "target_name": "msmu",
  "target_version_pattern": "^0\\.4\\.",
  "tables": [
    {
      "output": ".h5mu",
      "base": {
        "accession_syntax": {
          "msmu": {
            "separator": ";",
            "contaminant_markers": ["contam_", "Cont_", "CON__"],
            "contaminant_prefix": "Cont_"
          }
        }
      },
      "levels": {
        "peptidoform_ion": {
          "modality": "psm",
          "axis": {"obs_key": "filename", "var_key": "precursor"},
          "measurements": {
            "primary_layer": "abundance",
            "layers": [
              {
                "name": "abundance",
                "source": {"measurements": "primary_layer"},
                "width": 32,
                "missing_values": [0]
              },
              {
                "name": "q_value",
                "source": {
                  "catalog": "proteobench_entrapment_alpha",
                  "var": "library_q_value",
                  "accept": "nonzero"
                },
                "fallback": [
                  {"catalog": "proteobench_entrapment_alpha", "var": "q_value"},
                  {"catalog": "confidence_alpha", "layers": "q_value"}
                ],
                "width": 32,
                "required": false
              },
              {
                "name": "PEP",
                "source": {"catalog": "confidence_alpha", "layers": "pep"},
                "width": 32,
                "required": false
              }
            ]
          },
          "columns": {
            "obs": [{"name": "filename", "source": {"axis": "obs_key"}}],
            "var": [
              {"name": "precursor", "source": {"catalog": "apb_alpha", "var": "peptidoform_ion"}},
              {
                "name": "proteins",
                "how": "accessions",
                "source": {"catalog": "apb_alpha", "var": "fasta_accessions"},
                "syntax": "msmu",
                "drop_missing": true
              },
              {"name": "peptide", "source": {"catalog": "apb_alpha", "var": "peptidoform"}},
              {"name": "stripped_peptide", "source": {"catalog": "apb_alpha", "var": "peptide"}},
              {
                "name": "charge",
                "how": "proforma_charge",
                "source": {"catalog": "apb_alpha", "var": "peptidoform_ion"},
                "type": "integer"
              },
              {
                "name": "peptide_length",
                "how": "sequence_length",
                "source": {"catalog": "apb_alpha", "var": "peptide"},
                "type": "integer"
              },
              {
                "name": "decoy",
                "source": {"catalog": "apb_alpha", "var": "decoy"},
                "type": "integer"
              },
              {"name": "contaminant", "how": "contaminant", "type": "integer"},
              {
                "name": "PEP",
                "how": "layer_minimum",
                "layer": "PEP",
                "type": "number",
                "required": false,
                "fill_value": "NaN"
              },
              {
                "name": "q_value",
                "how": "layer_minimum",
                "layer": "q_value",
                "type": "number",
                "required": false
              }
            ]
          },
          "uns": [
            {"name": "level", "how": "constant", "value": "precursor"},
            {
              "name": "search_engine",
              "how": "lowercase",
              "source": {"rule": "software_name"},
              "required": false,
              "fill_value": "unknown"
            },
            {
              "name": "quantification",
              "how": "lowercase",
              "source": {"rule": "software_name"},
              "required": false,
              "fill_value": "unknown"
            },
            {"name": "label", "how": "constant", "value": "label_free"},
            {"name": "acquisition", "how": "constant", "value": null},
            {"name": "identification_file", "how": "constant", "value": null},
            {"name": "quantification_file", "how": "constant", "value": null},
            {"name": "apb_export_status", "how": "constant", "value": "experimental"}
          ]
        }
      }
    }
  ]
}
