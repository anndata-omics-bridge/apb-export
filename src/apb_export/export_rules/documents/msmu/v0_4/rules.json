{
  "schema_version": "0.4",
  "file_version": "3",
  "target_name": "msmu",
  "target_version_pattern": "^0\\.4\\.",
  "tables": [
    {
      "output": {"extensions": [".h5mu"]},
      "base": {
        "accession_syntax": {
          "msmu": {
            "separator": ";",
            "contaminant_markers": ["contam_", "Cont_", "CON__"],
            "contaminant_prefix": "Cont_"
          }
        }
      },
      "levels": {
        "peptidoform_ion": {
          "modality": "psm",
          "axis": {"obs_keys": ["filename"], "var_keys": ["precursor"]},
          "measurements": {
            "primary_layer": "abundance",
            "layers": [
              {
                "name": "abundance",
                "source": {"measurements": "primary_layer"},
                "width": 32,
                "missing_values": [0]
              },
              {
                "name": "q_value",
                "source": [
                  {
                    "catalog": "proteobench_entrapment",
                    "kind": "library_q_value",
                    "location": "var",
                    "accept": "nonzero"
                  },
                  {
                    "catalog": "proteobench_entrapment",
                    "kind": "global_q_value",
                    "location": "var"
                  },
                  {
                    "catalog": "confidence",
                    "kind": "q_value"
                  }
                ],
                "width": 32
              },
              {
                "name": "PEP",
                "source": {
                  "catalog": "confidence",
                  "kind": "pep"
                },
                "width": 32
              }
            ]
          },
          "columns": {
            "obs": [
              {"name": "filename", "source": {"axis": "obs_keys"}}
            ],
            "var": [
              {"name": "precursor", "source": {"catalog": "apb", "kind": "peptidoform_ion", "location": "var"}},
              {
                "name": "proteins",
                "how": "accessions",
                "inputs": [{"catalog": "apb", "kind": "fasta_accessions", "location": "var"}],
                "syntax": "msmu",
                "drop_missing": true
              },
              {"name": "peptide", "source": {"catalog": "apb", "kind": "peptidoform", "location": "var"}},
              {"name": "stripped_peptide", "source": {"catalog": "apb", "kind": "peptide", "location": "var"}},
              {
                "name": "charge",
                "how": "proforma_charge",
                "inputs": [{"catalog": "apb", "kind": "peptidoform_ion", "location": "var"}],
                "type": "integer"
              },
              {
                "name": "peptide_length",
                "how": "sequence_length",
                "inputs": [{"catalog": "apb", "kind": "peptide", "location": "var"}],
                "type": "integer"
              },
              {"name": "decoy", "source": {"catalog": "apb", "kind": "decoy", "location": "var"}, "type": "integer"},
              {"name": "contaminant", "how": "contaminant", "type": "integer"},
              {
                "name": "PEP",
                "how": "layer_minimum",
                "source": {
                  "catalog": "confidence",
                  "kind": "pep"
                },
                "type": "number",
                "required": false,
                "fill_value": "NaN"
              },
              {
                "name": "q_value",
                "how": "layer_minimum",
                "source": [
                  {
                    "catalog": "proteobench_entrapment",
                    "kind": "library_q_value",
                    "location": "var",
                    "accept": "nonzero"
                  },
                  {
                    "catalog": "proteobench_entrapment",
                    "kind": "global_q_value",
                    "location": "var"
                  },
                  {
                    "catalog": "confidence",
                    "kind": "q_value"
                  }
                ],
                "type": "number",
                "required": false
              }
            ]
          },
          "uns": [
            {"name": "level", "how": "constant", "value": "precursor"},
            {
              "name": "search_engine",
              "how": "lowercase",
              "inputs": [{"rule": "software_name"}],
              "required": false,
              "fill_value": "unknown"
            },
            {
              "name": "quantification",
              "how": "lowercase",
              "inputs": [{"rule": "software_name"}],
              "required": false,
              "fill_value": "unknown"
            },
            {"name": "label", "how": "constant", "value": "label_free"},
            {"name": "acquisition", "how": "constant", "value": null},
            {"name": "identification_file", "how": "constant", "value": null},
            {"name": "quantification_file", "how": "constant", "value": null},
            {"name": "apb_export_status", "how": "constant", "value": "experimental"}
          ]
        }
      }
    }
  ]
}
