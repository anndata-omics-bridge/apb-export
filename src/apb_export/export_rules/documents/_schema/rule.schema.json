{
  "$defs": {
    "AccessionSyntax": {
      "additionalProperties": false,
      "description": "How a target writes protein-group members, like apb2's ``sequence_syntax``.",
      "properties": {
        "separator": {
          "minLength": 1,
          "title": "Separator",
          "type": "string"
        },
        "contaminant_markers": {
          "items": {
            "type": "string"
          },
          "title": "Contaminant Markers",
          "type": "array"
        },
        "contaminant_prefix": {
          "default": "",
          "title": "Contaminant Prefix",
          "type": "string"
        }
      },
      "required": [
        "separator"
      ],
      "title": "AccessionSyntax",
      "type": "object"
    },
    "Accessions": {
      "additionalProperties": false,
      "description": "Protein-group members rewritten by a named ``accession_syntax``.",
      "properties": {
        "name": {
          "description": "The target field; apb2's rules name APB fields.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType",
          "default": "string"
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloatWidth"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Float width of a number entry; 64 when omitted."
        },
        "required": {
          "default": true,
          "description": "An absent source is an error; when false, the entry is skipped or filled.",
          "title": "Required",
          "type": "boolean"
        },
        "fill_value": {
          "$ref": "#/$defs/Scalar",
          "default": null,
          "description": "Written when an optional source is absent; \"NaN\" for numbers."
        },
        "index_only": {
          "default": false,
          "description": "An axis entry that becomes the index without being written as a column.",
          "title": "Index Only",
          "type": "boolean"
        },
        "named_index": {
          "default": false,
          "description": "The index takes this axis entry's name, as AlphaPeptTools' levels need.",
          "title": "Named Index",
          "type": "boolean"
        },
        "how": {
          "const": "accessions",
          "title": "How",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "syntax": {
          "minLength": 1,
          "title": "Syntax",
          "type": "string"
        }
      },
      "required": [
        "name",
        "how",
        "inputs",
        "syntax"
      ],
      "title": "Accessions",
      "type": "object"
    },
    "AllValues": {
      "additionalProperties": false,
      "description": "Everything the APB level carries that the rule does not name.\n\nIn ``varm``: every var column and layer value at the written rows, the level's key first.\nIn ``columns.obs``: every obs annotation column, under its own name.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "how": {
          "const": "all_values",
          "title": "How",
          "type": "string"
        }
      },
      "required": [
        "name",
        "how"
      ],
      "title": "AllValues",
      "type": "object"
    },
    "AnnotationMap": {
      "additionalProperties": false,
      "description": "Every obs annotation column mapped to its own name; ``uns`` only.",
      "properties": {
        "name": {
          "description": "The target field; apb2's rules name APB fields.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType",
          "default": "string"
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloatWidth"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Float width of a number entry; 64 when omitted."
        },
        "required": {
          "default": true,
          "description": "An absent source is an error; when false, the entry is skipped or filled.",
          "title": "Required",
          "type": "boolean"
        },
        "fill_value": {
          "$ref": "#/$defs/Scalar",
          "default": null,
          "description": "Written when an optional source is absent; \"NaN\" for numbers."
        },
        "index_only": {
          "default": false,
          "description": "An axis entry that becomes the index without being written as a column.",
          "title": "Index Only",
          "type": "boolean"
        },
        "named_index": {
          "default": false,
          "description": "The index takes this axis entry's name, as AlphaPeptTools' levels need.",
          "title": "Named Index",
          "type": "boolean"
        },
        "how": {
          "const": "annotation_map",
          "title": "How",
          "type": "string"
        }
      },
      "required": [
        "name",
        "how"
      ],
      "title": "AnnotationMap",
      "type": "object"
    },
    "Axis": {
      "additionalProperties": false,
      "description": "The entries that become the target's observation and variable index.",
      "properties": {
        "obs_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Obs Keys",
          "type": "array"
        },
        "var_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Var Keys",
          "type": "array"
        }
      },
      "required": [
        "obs_keys",
        "var_keys"
      ],
      "title": "Axis",
      "type": "object"
    },
    "AxisSource": {
      "additionalProperties": false,
      "description": "The level's observation or variable key column; a composite key is refused.",
      "properties": {
        "axis": {
          "enum": [
            "obs_keys",
            "var_keys"
          ],
          "title": "Axis",
          "type": "string"
        }
      },
      "required": [
        "axis"
      ],
      "title": "AxisSource",
      "type": "object"
    },
    "CatalogueSource": {
      "additionalProperties": false,
      "description": "A field found by meaning through apb-catalog.",
      "properties": {
        "catalogue": {
          "minLength": 1,
          "title": "Catalogue",
          "type": "string"
        },
        "concept": {
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "default": "layers",
          "enum": [
            "layers",
            "var"
          ],
          "title": "Location",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "const": "protein",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Read the field from this level through each variable's protein_assignment, as a layer: a cell takes its protein group's value in its run; a var column's value repeats in every run. A group the level lacks reads as missing.",
          "title": "Level"
        },
        "accept": {
          "default": "present",
          "description": "nonzero rejects a layer holding no finite nonzero value, such as DIA-NN's library q-value without match-between-runs.",
          "enum": [
            "present",
            "nonzero"
          ],
          "title": "Accept",
          "type": "string"
        }
      },
      "required": [
        "catalogue",
        "concept",
        "kind"
      ],
      "title": "CatalogueSource",
      "type": "object"
    },
    "ColumnEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcedEntry"
        },
        {
          "$ref": "#/$defs/ComputedEntry"
        }
      ]
    },
    "ColumnType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ],
      "type": "string"
    },
    "Columns": {
      "additionalProperties": false,
      "description": "The target's observation and variable columns, and var-aligned tables.",
      "properties": {
        "obs": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ColumnEntry"
              },
              {
                "$ref": "#/$defs/AllValues"
              }
            ]
          },
          "title": "Obs",
          "type": "array"
        },
        "var": {
          "items": {
            "$ref": "#/$defs/ColumnEntry"
          },
          "minItems": 1,
          "title": "Var",
          "type": "array"
        },
        "varm": {
          "items": {
            "$ref": "#/$defs/AllValues"
          },
          "title": "Varm",
          "type": "array"
        }
      },
      "required": [
        "var"
      ],
      "title": "Columns",
      "type": "object"
    },
    "ComputedEntry": {
      "discriminator": {
        "mapping": {
          "accessions": "#/$defs/Accessions",
          "annotation_map": "#/$defs/AnnotationMap",
          "constant": "#/$defs/Constant",
          "contaminant": "#/$defs/Contaminant",
          "join_nonempty": "#/$defs/JoinNonempty",
          "lowercase": "#/$defs/Lowercase",
          "proforma_charge": "#/$defs/ProformaCharge",
          "sequence_length": "#/$defs/SequenceLength"
        },
        "propertyName": "how"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Constant"
        },
        {
          "$ref": "#/$defs/JoinNonempty"
        },
        {
          "$ref": "#/$defs/ProformaCharge"
        },
        {
          "$ref": "#/$defs/SequenceLength"
        },
        {
          "$ref": "#/$defs/Accessions"
        },
        {
          "$ref": "#/$defs/Contaminant"
        },
        {
          "$ref": "#/$defs/Lowercase"
        },
        {
          "$ref": "#/$defs/AnnotationMap"
        }
      ]
    },
