{
  "schema_version": "0.5",
  "file_version": "3",
  "target_name": "AlphaPeptTools",
  "target_version_pattern": "^0\\.4\\.",
  "tables": [
    {
      "output": ".h5mu",
      "base": {
        "measurements": {
          "primary_layer": "intensity",
          "layers": [{"name": "intensity", "source": {"measurements": "primary_layer"}}]
        },
        "columns": {
          "obs": [
            {"name": "raw_name", "source": {"axis": "obs_key"}},
            {"name": "annotations", "how": "all_values"}
          ]
        }
      },
      "levels": {
        "peptidoform_ion": {
          "modality": "precursors",
          "axis": {"obs_key": "raw_name", "var_key": "precursor_id"},
          "columns": {
            "var": [
              {
                "name": "precursor_id",
                "source": {"catalog": "apb_alpha", "var": "peptidoform_ion"}
              },
              {"name": "sequence", "source": {"catalog": "apb_alpha", "var": "peptide"}},
              {"name": "proteins", "source": {"catalog": "apb_alpha", "var": "protein_assignment"}},
              {"name": "contaminant", "how": "contaminant", "type": "boolean"},
              {
                "name": "in_fasta",
                "source": {"catalog": "fasta_peptides_alpha", "var": "peptide_in_fasta"},
                "type": "boolean",
                "required": false
              },
              {
                "name": "fasta_proteins",
                "source": {"catalog": "fasta_peptides_alpha", "var": "fasta_matching_protein_ids"},
                "required": false
              },
              {
                "name": "fasta_organisms",
                "source": {"catalog": "fasta_peptides_alpha", "var": "fasta_matching_organisms"},
                "required": false
              }
            ]
          }
        },
        "peptide": {
          "modality": "peptides",
          "required": false,
          "axis": {"obs_key": "raw_name", "var_key": "sequence"},
          "columns": {
            "var": [
              {"name": "sequence", "source": {"catalog": "apb_alpha", "var": "peptide"}},
              {
                "name": "proteins",
                "source": {"catalog": "apb_alpha", "var": "protein_assignment"},
                "required": false
              },
              {"name": "contaminant", "how": "contaminant", "type": "boolean"},
              {
                "name": "in_fasta",
                "source": {"catalog": "fasta_peptides_alpha", "var": "peptide_in_fasta"},
                "type": "boolean",
                "required": false
              },
              {
                "name": "fasta_proteins",
                "source": {"catalog": "fasta_peptides_alpha", "var": "fasta_matching_protein_ids"},
                "required": false
              },
              {
                "name": "fasta_organisms",
                "source": {"catalog": "fasta_peptides_alpha", "var": "fasta_matching_organisms"},
                "required": false
              }
            ]
          }
        },
        "protein": {
          "modality": "proteins",
          "required": false,
          "axis": {"obs_key": "raw_name", "var_key": "proteins"},
          "columns": {
            "var": [
              {"name": "proteins", "source": {"catalog": "apb_alpha", "var": "protein_assignment"}}
            ]
          }
        }
      }
    }
  ]
}
